{
  "tapaus": "android-ruutu-screencap-epaonnistuu",
  "pyynto": {
    "metodi": "GET",
    "polku": "/api/android/ruutu",
    "runko": null
  },
  "ymparisto": {
    "skooppitiedot": {
      "a": [
        "R.md"
      ],
      "b": [
        "R.md"
      ],
      "scopes koe": [
        "R.md"
      ]
    },
    "istunnot": [],
    "transkriptit": [],
    "tmux": {
      "display-message": "<PID>\n",
      "capture-pane": "",
      "list-panes": ""
    },
    "komennot": {
      "vastaukset": [
        {
          "komento": "adb",
          "sisaltaa": "dumpsys power",
          "stdout": "mWakefulness=Awake\n"
        },
        {
          "komento": "adb",
          "sisaltaa": "wm size",
          "stdout": "Physical size: 1080x2400\n"
        },
        {
          "komento": "adb",
          "sisaltaa": "screencap",
          "koodi": 1,
          "stderr": "error: closed"
        }
      ]
    }
  },
  "odotus": {
    "status": 502,
    "runko": {
      "virhe": "screencap epäonnistui: error: closed"
    },
    "aja": [
      [
        "adb",
        "-s",
        "127.0.0.1:5555",
        "shell",
        "dumpsys power | grep mWakefulness="
      ],
      [
        "adb",
        "-s",
        "127.0.0.1:5555",
        "exec-out",
        "screencap",
        "-p"
      ]
    ]
  }
}
